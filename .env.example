# Copy to .env and adjust. NEVER commit .env — it is gitignored.
#   cp .env.example .env

# ── MLflow ────────────────────────────────────────────────────────────────
# Local file store for dev. In compose this becomes http://mlflow:5000.
# In production this may carry credentials — that is why .env is gitignored.
MLFLOW_TRACKING_URI=file:///home/dhruv/projects/churn-mlops/mlruns
MLFLOW_EXPERIMENT=churn-prediction

# ── Model registry ────────────────────────────────────────────────────────
MODEL_NAME=churn-classifier
# Which registry stage the API serves: None | Staging | Production
MODEL_STAGE=Production
# Offline fallback when no registry is reachable (CI, local dev)
LOCAL_MODEL_PATH=./models/model

# ── Data ──────────────────────────────────────────────────────────────────
DATA_PATH=./data/telco_churn.csv

# ── Decision threshold ────────────────────────────────────────────────────
# NOT 0.5. Set this to the cost-optimal value that train.py reports, chosen on
# out-of-fold predictions. See README "Threshold selection".
# DECISION_THRESHOLD=0.37

# ── Browser access ────────────────────────────────────────────────────────
# Comma-separated origins the API answers to from a browser. Unset means
# http://localhost:8501 and http://127.0.0.1:8501 — enough for a local
# deployment. The bundled Streamlit portal does NOT need this: it calls the
# API server-side, so no browser request crosses an origin. Set it only if
# you are pointing your own browser-side page at this API. See ADR 0004.
# CORS_ORIGINS=https://your-own-page.example

# POST /reload changes which model is served, so it requires the header
#   X-Churnkit-Admin: 1
# The value is ignored and is not a secret. It exists so that a page you are
# merely visiting cannot reload the model on your behalf. ADR 0004 explains
# what that does and does not protect.
