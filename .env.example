# Copy to .env and adjust. NEVER commit .env — it is gitignored.
#   cp .env.example .env

# ── MLflow ────────────────────────────────────────────────────────────────
# Local file store for dev. In compose this becomes http://mlflow:5000.
# In production this may carry credentials — that is why .env is gitignored.
MLFLOW_TRACKING_URI=file:///home/dhruv/projects/churn-mlops/mlruns
MLFLOW_EXPERIMENT=churn-prediction

# ── Model registry ────────────────────────────────────────────────────────
MODEL_NAME=churn-classifier
# Which registry stage the API serves: None | Staging | Production
MODEL_STAGE=Production
# Offline fallback when no registry is reachable (CI, local dev)
LOCAL_MODEL_PATH=./models/model

# ── Data ──────────────────────────────────────────────────────────────────
DATA_PATH=./data/telco_churn.csv

# ── Decision threshold ────────────────────────────────────────────────────
# NOT 0.5. Set this to the cost-optimal value that train.py reports, chosen on
# out-of-fold predictions. See README "Threshold selection".
DECISION_THRESHOLD=0.5

# ── Deployment only ───────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS. Tighten before going public.
# CORS_ORIGINS=https://your-streamlit-app.streamlit.app
