FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# UI dependencies only. The model stack is deliberately absent: this container
# must not be able to load a model even by accident.
COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

# schema.py and labels.py are imported for the form options and the readable
# SHAP names, keeping the feature contract in one place.
COPY src/__init__.py src/schema.py src/labels.py ./src/
COPY app/ ./app/

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "app/streamlit_app.py", \
            "--server.port=8501", "--server.address=0.0.0.0", \
            "--server.headless=true"]
